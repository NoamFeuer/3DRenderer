# A simple square pyramid centred at the origin (per-face normals).
# Used by the LitScene example to exercise Renderer::drawMesh / Mesh::loadObj.

v -0.5 -0.5 -0.5
v  0.5 -0.5 -0.5
v  0.5 -0.5  0.5
v -0.5 -0.5  0.5
v  0.0  0.5  0.0

vn  0 -1  0
vn  0  0 -1
vn  1  0  0
vn  0  0  1
vn -1  0  0

f 1//2 2//2 5//2
f 2//3 3//3 5//3
f 3//4 4//4 5//4
f 4//5 1//5 5//5
f 4//1 3//1 2//1 1//1